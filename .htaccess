RewriteRule ^auth/forgot-password/?$ auth/forgot-password/index.html [END]
RewriteRule ^auth/reset-password/?$ auth/reset-password/index.html [END]
RewriteRule ^portal/?$ portal/index.php [END]
RewriteRule ^portal/dashboard/?$ portal/dashboard/index.php [END]
RewriteRule ^portal/investments/?$ portal/investments/index.php [END]
RewriteRule ^portal/investments/preview/?$ portal/investments/preview.php [END]
