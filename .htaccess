Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Use static, branded responses for common client/server errors.
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 505 /505.html

# Redirect direct public index and page HTML requests to their folder URLs.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteCond %{THE_REQUEST} \s/+(.+)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1/ [R=301,L,NE]

# Redirect direct PHP requests to their canonical clean URL.
RewriteCond %{THE_REQUEST} \s/+share/user/([^\s?]+)\.php(?:[\s?]) [NC]
RewriteRule ^share/user/(.+)\.php$ /share/user/$1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+admin/index\.php(?:[\s?]) [NC]
RewriteRule ^admin/index\.php$ /admin/ [R=301,L]

# Keep private routes out of search indexes and expose stable extensionless URLs.
RewriteRule ^about-us/?$ pages/about-us/index.html [END]
RewriteRule ^agriculture/?$ pages/agriculture/index.html [END]
RewriteRule ^corporate-governance/?$ pages/corporate-governance/index.html [END]
RewriteRule ^credit/?$ pages/credit/index.html [END]
RewriteRule ^crypto/?$ pages/crypto/index.html [END]
RewriteRule ^diversity-equity-inclusion/?$ pages/diversity-equity-inclusion/index.html [END]
RewriteRule ^environmental-social-and-governance/?$ pages/environmental-social-and-governance/index.html [END]
RewriteRule ^gold-backed-currencies/?$ pages/gold-backed-currencies/index.html [END]
RewriteRule ^investment-management/?$ pages/investment-management/index.html [END]
RewriteRule ^medical-cannabis/?$ pages/medical-cannabis/index.html [END]
RewriteRule ^nft/?$ pages/nft/index.html [END]
RewriteRule ^oil-gas/?$ pages/oil-gas/index.html [END]
